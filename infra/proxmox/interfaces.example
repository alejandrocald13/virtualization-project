auto lo
iface lo inet loopback

iface nic0 inet manual

auto wlp3s0
iface wlp3s0 inet dhcp
    post-up sysctl -w net.ipv4.conf.wlp3s0.proxy_arp=1
    wpa-ssid kubelab-grupo6
    wpa-psk <HOTSPOT_PSK_HEX>
    post-up iw dev wlp3s0 set power_save off

auto vmbr0
iface vmbr0 inet static
    post-up ip route replace 10.96.252.240/30 dev vmbr0
    address 10.10.10.1/24
    bridge-ports none
    bridge-stp off
    bridge-fd 0
    post-up   echo 1 > /proc/sys/net/ipv4/ip_forward
    post-up   iptables -t nat -A POSTROUTING -s 10.10.10.0/24 -o wlp3s0 -j MASQUERADE
    post-down iptables -t nat -D POSTROUTING -s 10.10.10.0/24 -o wlp3s0 -j MASQUERADE

source /etc/network/interfaces.d/*
